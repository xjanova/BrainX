<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="BrainX.ServerManager" />

  <!-- Starting/stopping BrainXNode and cloudflared and writing the service
       Environment under HKLM all need an elevated token. Asking up front beats
       failing halfway through a Restart. If the app still ends up unelevated
       (UAC off for a standard user, a compat shim), it detects that and runs
       read-only with a "restart as administrator" button. -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 / 11 and Windows Server 2016 / 2019 / 2022 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

  <!-- DPI awareness is NOT declared here: WinForms takes it from
       ApplicationHighDpiMode in the csproj and warns when both are set. -->
</assembly>
