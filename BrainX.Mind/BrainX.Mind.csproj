<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BrainX.Mind</AssemblyName>
    <RootNamespace>BrainX.Mind</RootNamespace>
    <Product>Mind — BrainX assistant</Product>
    <Version>1.0.0</Version>
    <!-- Its own app, launched on its own. The dashboard is not required to be
         running, and closing the dashboard must not close her. -->
    <!-- no .ico in the repo; the exe keeps the default until one is added -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BrainX.Core\BrainX.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
  </ItemGroup>

  <!-- Everything she renders. Copied beside the exe so this app is standalone -
       it must not reach into the dashboard's install directory, which Velopack
       replaces wholesale on update.

       THREE GROUPS, NOT ONE GLOB. %(RecursiveDir) only holds the part that `**`
       itself matched, so a single Include of universe\**\*.* flattens vendor\
       and avatar\ into the root and the page 404s every asset it asks for. Each
       subtree therefore carries its own Link prefix. -->
  <ItemGroup>
    <Content Include="..\BrainX.Client\wwwroot\universe\assistant-window.html;
                      ..\BrainX.Client\wwwroot\universe\avatar.js;
                      ..\BrainX.Client\wwwroot\universe\motion.js;
                      ..\BrainX.Client\wwwroot\universe\idle.js;
                      ..\BrainX.Client\wwwroot\universe\lipsync.js;
                      ..\BrainX.Client\wwwroot\universe\framing.js"
             Link="wwwroot\universe\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <!-- Only her three. vendor\ also holds the dashboard's d3, which she has
         no use for and should not be shipping.

         ONE GROUP PER PACKAGE, for the same reason as above and one level
         down: `**` here begins INSIDE vendor\three\, so %(RecursiveDir) is
         `jsm\loaders\` and never `three\jsm\loaders\`. Sharing a Link
         prefix of vendor\ across the three packages therefore drops the
         package name from every path — GLTFLoader.js shipped as
         vendor\jsm\loaders\ while the page asked for vendor\three\jsm\
         loaders\, and she came up as an empty blue window. -->
    <Content Include="..\BrainX.Client\wwwroot\universe\vendor\three\**\*.js"
             Link="wwwroot\universe\vendor\three\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\BrainX.Client\wwwroot\universe\vendor\three-vrm\**\*.*"
             Link="wwwroot\universe\vendor\three-vrm\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\BrainX.Client\wwwroot\universe\vendor\vrm-mixamo\**\*.js"
             Link="wwwroot\universe\vendor\vrm-mixamo\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <!-- The MANIFEST only. The model and its clips are 33 MB that change
         almost never, and shipping them inside the package would re-send the
         lot on every Velopack update. They are fetched once at run time and
         cached beside `current` — see AvatarPackService. -->
    <Content Include="..\BrainX.Client\wwwroot\universe\avatar\clips.json"
             Link="wwwroot\universe\avatar\clips.json"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
