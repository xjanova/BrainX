<!--
  BrainXColors.xaml — Design token color palette for the redesigned UI.

  Lifted from design_handoff_brainx_redesign/design/styles.css. Every token
  here maps 1:1 to a CSS custom property in the prototype. Naming convention
  is "Neural" + role so it doesn't collide with the legacy CyberpunkTheme
  brushes (BgDark, NeonCyan, …) that the existing views still consume; both
  dictionaries can coexist during the multi-phase migration.

  When a phase finishes migrating a view, swap the StaticResource references
  in that view's XAML from the legacy keys to the Neural* keys. When all
  views are migrated, the legacy dictionary can be retired.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ═══════════════════════════════════════════════════════════════════
       Surfaces (layered depth — see prototype CSS bg tokens)
       ═══════════════════════════════════════════════════════════════════ -->
  <!-- Obsidian, 2026-09-20. The old surfaces were a saturated purple-black
       (#0b0818 → #211b40); these are graphite with a trace of blue, which is
       what lets one warm accent read as metal instead of as another glow.
       The STEPS between them are deliberately small and even — depth on a
       dark UI comes from consistent spacing between layers, not contrast. -->
  <SolidColorBrush x:Key="NeuralBgVoid"     Color="#07080c"/>
  <SolidColorBrush x:Key="NeuralBgBase"     Color="#0b0d13"/>
  <SolidColorBrush x:Key="NeuralBgElevated" Color="#12151d"/>
  <SolidColorBrush x:Key="NeuralBgCard"     Color="#171b25"/>
  <SolidColorBrush x:Key="NeuralBgCard2"    Color="#1e222d"/>
  <SolidColorBrush x:Key="NeuralBgInset"    Color="#0a0c11"/>
  <!-- WPF lacks backdrop-filter:blur(); approximate "glass" as 72%-opaque card. -->
  <SolidColorBrush x:Key="NeuralBgGlass"    Color="#171b25" Opacity="0.72"/>

  <!-- ═══════════════════════════════════════════════════════════════════
       Borders / dividers
       ═══════════════════════════════════════════════════════════════════ -->
  <!-- Hairlines in warm white rather than violet: a tinted divider on a
       neutral surface reads as a colour choice, and a neutral one reads as an
       edge. The accent line is the champagne, at the opacity where it looks
       like a lit bevel rather than a highlighter. -->
  <SolidColorBrush x:Key="NeuralLine"        Color="#F2EFE6" Opacity="0.07"/>
  <SolidColorBrush x:Key="NeuralLineStrong"  Color="#F2EFE6" Opacity="0.13"/>
  <SolidColorBrush x:Key="NeuralLineAccent"  Color="#D8B978" Opacity="0.34"/>

  <!-- ═══════════════════════════════════════════════════════════════════
       Brand palette (refined neural — keep in sync with category mapping below)
       ═══════════════════════════════════════════════════════════════════ -->
  <!-- The interactive accent. Named Violet in a hundred places and now a
       champagne gold — renaming the key would be a mechanical diff across
       every view for no behavioural gain, and the comment is cheaper than
       the churn. Deep is the pressed/!border state, 2 is the hover. -->
  <SolidColorBrush x:Key="NeuralViolet"      Color="#d8b978"/>
  <SolidColorBrush x:Key="NeuralViolet2"     Color="#f0dcae"/>
  <SolidColorBrush x:Key="NeuralVioletDeep"  Color="#a8863f"/>
  <SolidColorBrush x:Key="NeuralCyan"        Color="#5be9e9"/>
  <SolidColorBrush x:Key="NeuralCyanDeep"    Color="#2bb8b8"/>
  <SolidColorBrush x:Key="NeuralMagenta"     Color="#ff4f9e"/>
  <SolidColorBrush x:Key="NeuralMagentaDeep" Color="#d62677"/>
  <SolidColorBrush x:Key="NeuralMint"        Color="#4ae3a7"/>
  <SolidColorBrush x:Key="NeuralAmber"       Color="#ffc23c"/>
  <SolidColorBrush x:Key="NeuralRose"        Color="#ff6b6b"/>

  <!-- Raw Color resources (when you need a Color, not a Brush — gradients, drop shadows) -->
  <Color x:Key="NeuralVioletColor">#9d7bff</Color>
  <Color x:Key="NeuralViolet2Color">#b89dff</Color>
  <Color x:Key="NeuralVioletDeepColor">#6a48d6</Color>
  <Color x:Key="NeuralCyanColor">#5be9e9</Color>
  <Color x:Key="NeuralMagentaColor">#ff4f9e</Color>
  <Color x:Key="NeuralMintColor">#4ae3a7</Color>
  <Color x:Key="NeuralAmberColor">#ffc23c</Color>
  <Color x:Key="NeuralRoseColor">#ff6b6b</Color>

  <!-- ═══════════════════════════════════════════════════════════════════
       Text — five tiers from brightest primary to disabled
       ═══════════════════════════════════════════════════════════════════ -->
  <!-- Warm neutrals. The old tiers were violet-tinted (#f1ecff → #5a546f),
       which on a neutral surface looks like text that has been coloured in;
       a trace of warmth reads as paper and sits correctly next to gold. -->
  <SolidColorBrush x:Key="NeuralText"    Color="#f2f0ea"/>
  <SolidColorBrush x:Key="NeuralText1"   Color="#d5d2c9"/>
  <SolidColorBrush x:Key="NeuralText2"   Color="#a6a39b"/>
  <SolidColorBrush x:Key="NeuralText3"   Color="#7c7a75"/>
  <SolidColorBrush x:Key="NeuralTextDim" Color="#5c5b57"/>

  <!-- ═══════════════════════════════════════════════════════════════════
       Category colors (24 expertise categories, used as data colors on
       graph nodes, chart lines, tag pills). Only the top-10 are listed
       here; the long tail lives in BrainXCategoryColors.xaml (Phase 2).
       ═══════════════════════════════════════════════════════════════════ -->
  <SolidColorBrush x:Key="CatProgramming"        Color="#5be9e9"/>
  <SolidColorBrush x:Key="CatDataScience"        Color="#ffc23c"/>
  <SolidColorBrush x:Key="CatDesignArt"          Color="#ff4f9e"/>
  <SolidColorBrush x:Key="CatEngineering"        Color="#4ae3a7"/>
  <SolidColorBrush x:Key="CatBlockchainWeb3"     Color="#ff8a4f"/>
  <SolidColorBrush x:Key="CatBusinessFinance"    Color="#7bd87b"/>
  <SolidColorBrush x:Key="CatWebDevelopment"     Color="#74d2ff"/>
  <SolidColorBrush x:Key="CatAIMachineLearning"  Color="#9d7bff"/>
  <SolidColorBrush x:Key="CatSecurityCrypto"     Color="#ff6b6b"/>
  <SolidColorBrush x:Key="CatMathematics"        Color="#67c8ff"/>

  <!-- ═══════════════════════════════════════════════════════════════════
       Ambient gradients (the nebula behind the app shell — three soft
       radial blobs at fixed positions). WPF radials can't replicate the
       CSS percent-positioned blobs exactly, so use a single layered
       LinearGradientBrush as a starter; ambient layer can be refined later.
       ═══════════════════════════════════════════════════════════════════ -->
  <LinearGradientBrush x:Key="NeuralNebula" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#10131c" Offset="0"/>
    <GradientStop Color="#0b0d13" Offset="0.5"/>
    <GradientStop Color="#090b10" Offset="1"/>
  </LinearGradientBrush>

  <!-- Titlebar. The brightest stop in the app sits on its top pixel row,
       which is where the light is coming from for every bevel below it. -->
  <LinearGradientBrush x:Key="NeuralTitlebarBg" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#232834" Offset="0"/>
    <GradientStop Color="#191d27" Offset="0.45"/>
    <GradientStop Color="#11141c" Offset="1"/>
  </LinearGradientBrush>

  <!-- Sidebar / status bar. Obsidian, and angled: EndPoint carries a little
       X so the light falls across the rail as well as down it, which is what
       stops a 900px-tall column reading as a single painted slab. -->
  <LinearGradientBrush x:Key="NeuralSidebarBg" StartPoint="0,0" EndPoint="0.35,1">
    <GradientStop Color="#181c26" Offset="0"/>
    <GradientStop Color="#12151e" Offset="0.6"/>
    <GradientStop Color="#0d1016" Offset="1"/>
  </LinearGradientBrush>

  <!-- Primary button: polished champagne. Four stops, because metal has a
       bright lip, a broad body and a fast fall-off - three makes plastic. -->
  <LinearGradientBrush x:Key="NeuralPrimaryBtn" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#f7ebcd" Offset="0"/>
    <GradientStop Color="#e4c98f" Offset="0.22"/>
    <GradientStop Color="#c9a55e" Offset="0.62"/>
    <GradientStop Color="#a8863f" Offset="1"/>
  </LinearGradientBrush>

  <!-- Sidebar nav-item active state (champagne tint, lit from the top) -->
  <LinearGradientBrush x:Key="NeuralNavActive" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#3Dd8b978" Offset="0"/>
    <!-- 0x3D = 24% alpha -->
    <GradientStop Color="#16d8b978" Offset="1"/>
    <!-- 0x14 = 8% alpha -->
  </LinearGradientBrush>

  <!-- Brand mark (titlebar 26×26 square) radial -->
  <RadialGradientBrush x:Key="NeuralBrandMark" GradientOrigin="0.3,0.3" Center="0.5,0.5" RadiusX="0.65" RadiusY="0.65">
    <GradientStop Color="#b89dff" Offset="0"/>
    <GradientStop Color="#6a48d6" Offset="0.6"/>
    <GradientStop Color="#2a1d5c" Offset="1"/>
  </RadialGradientBrush>

  <!-- User-pill avatar (titlebar right side) -->
  <LinearGradientBrush x:Key="NeuralUserAvatar" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#ff4f9e" Offset="0"/>
    <GradientStop Color="#9d7bff" Offset="1"/>
  </LinearGradientBrush>

  <!-- User bubble in chat (right-aligned, violet) -->
  <LinearGradientBrush x:Key="NeuralChatUser" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#2b2152" Offset="0"/>
    <GradientStop Color="#1d1640" Offset="1"/>
  </LinearGradientBrush>

  <!-- Brain-stage map background (cool nebula radial) — used for the graph
       viewport when no 3D scene is mounted. -->
  <RadialGradientBrush x:Key="NeuralStageBg" GradientOrigin="0.5,0.3" Center="0.5,0.3" RadiusX="0.8" RadiusY="0.8">
    <GradientStop Color="#190f3a" Offset="0"/>
    <GradientStop Color="#0a071a" Offset="0.8"/>
  </RadialGradientBrush>

  <!-- ═══════════════════════════════════════════════════════════════════
       Activity-feed kind badges (Dashboard right rail). One 135deg gradient
       per kind, same hex stops as the prototype's `.act-kind.X` CSS classes
       in views.css §"Activity list".
       ═══════════════════════════════════════════════════════════════════ -->
  <LinearGradientBrush x:Key="ActKindMcp" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#9d7bff" Offset="0"/>
    <GradientStop Color="#6a48d6" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="ActKindSave" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#4ae3a7" Offset="0"/>
    <GradientStop Color="#1aa57a" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="ActKindIndex" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#5be9e9" Offset="0"/>
    <GradientStop Color="#2bb8b8" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="ActKindAi" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#ffc23c" Offset="0"/>
    <GradientStop Color="#d68f10" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="ActKindPeer" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#ff4f9e" Offset="0"/>
    <GradientStop Color="#d62677" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="ActKindShare" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#74d2ff" Offset="0"/>
    <GradientStop Color="#3a96d8" Offset="1"/>
  </LinearGradientBrush>

  <!-- ═══════════════════════════════════════════════════════════════════
       PINK / HOT MAGENTA — the actual brand color per theme.zip handoff
       (claude_handoff_package/CLAUDE_HANDOFF.md §3).
       The Neural* set above leaned violet because the FIRST design handoff
       (brainx.zip) was violet-themed; the screenshot-based handoff that
       overrides it specifies hot pink. Keeping BOTH sets so views migrate
       independently — Neural keys still work where they're already wired.
       ═══════════════════════════════════════════════════════════════════ -->
  <SolidColorBrush x:Key="BrandPink"       Color="#ff2d8f"/>
  <SolidColorBrush x:Key="BrandPinkBright" Color="#ff5fa8"/>
  <SolidColorBrush x:Key="BrandPinkDeep"   Color="#c41e6e"/>
  <SolidColorBrush x:Key="BrandPinkGlow"   Color="#ff2d8f" Opacity="0.45"/>

  <Color x:Key="BrandPinkColor">#ff2d8f</Color>
  <Color x:Key="BrandPinkBrightColor">#ff5fa8</Color>
  <Color x:Key="BrandPinkDeepColor">#c41e6e</Color>

  <!-- Pink-tinted hairline / line / accent for the screenshots-aligned look -->
  <SolidColorBrush x:Key="PinkLine"        Color="#ff2d8f" Opacity="0.10"/>
  <SolidColorBrush x:Key="PinkLineStrong"  Color="#ff2d8f" Opacity="0.22"/>
  <SolidColorBrush x:Key="PinkLineAccent"  Color="#ff2d8f" Opacity="0.45"/>

  <!-- Pink primary-button gradient (Ask Claude per screenshot ai-brain-assistant.png) -->
  <LinearGradientBrush x:Key="PinkPrimaryBtn" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#ff5fa8" Offset="0"/>
    <GradientStop Color="#c41e6e" Offset="1"/>
  </LinearGradientBrush>

  <!-- Pink titlebar / sidebar gradient (screenshots show near-black with
       slight purple-pink tint, NOT the violet of the brainx.zip design) -->
  <LinearGradientBrush x:Key="PinkTitlebarBg" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#120a22" Offset="0"/>
    <GradientStop Color="#0a0612" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="PinkSidebarBg" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#0c0820" Offset="0"/>
    <GradientStop Color="#08051a" Offset="1"/>
  </LinearGradientBrush>

  <!-- Data colors lifted from theme.zip handoff (sec 3) — used by category
       dots in the Expertise overlay + neural-map nodes -->
  <SolidColorBrush x:Key="DataPink"   Color="#ff2d8f"/>
  <SolidColorBrush x:Key="DataCyan"   Color="#4ee7f0"/>
  <SolidColorBrush x:Key="DataAmber"  Color="#f5b04a"/>
  <SolidColorBrush x:Key="DataMint"   Color="#4ce3a4"/>
  <SolidColorBrush x:Key="DataViolet" Color="#9a7cff"/>
  <SolidColorBrush x:Key="DataOrange" Color="#ff8b4a"/>
  <SolidColorBrush x:Key="DataSky"    Color="#6cc8ff"/>

  <!-- ═══════════════════════════════════════════════════════════════════
       Material — faces and bevels (2026-09-20)

       Owner: "อยากได้มิติ มีสีเป็นเนื้อ นูน แบบ gpuxmine".

       A flat fill plus a drop shadow reads as a CARD ON a background. What
       reads as a THING is two more cues, and GPUxMINE's chrome theme uses
       both: a vertical gradient across the face, so the surface catches
       light unevenly the way a physical panel does, and an edge that is
       bright along the top and dark along the bottom, which is the bevel.
       Cheap, and it is the whole difference between "dark UI" and "object".

       WPF gives a Border ONE BorderBrush, so the bevel is that brush as a
       gradient rather than four separate edges — top-lit, bottom-shaded, in
       one element with no extra visual tree.

       The faces are deliberately shallow (three or four percent of
       lightness across the whole height). A steeper ramp on a dark surface
       bands visibly on 8-bit displays and starts to look like a gradient
       for its own sake instead of like a material.
       ═══════════════════════════════════════════════════════════════════ -->

  <LinearGradientBrush x:Key="NeuralFaceCard" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#20242f" Offset="0"/>
    <GradientStop Color="#1a1e28" Offset="0.55"/>
    <GradientStop Color="#141822" Offset="1"/>
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="NeuralFaceCardHover" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#272c39" Offset="0"/>
    <GradientStop Color="#1f242f" Offset="0.55"/>
    <GradientStop Color="#181c26" Offset="1"/>
  </LinearGradientBrush>

  <!-- Buttons sit one step proud of the card they are on, so their face
       starts brighter than the card's and ends at the same value. -->
  <LinearGradientBrush x:Key="NeuralFaceBtn" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#252a37" Offset="0"/>
    <GradientStop Color="#1d222d" Offset="0.52"/>
    <GradientStop Color="#161a24" Offset="1"/>
  </LinearGradientBrush>

  <!-- Chrome: the window's own furniture (sidebar, title, status bar). The
       ramp runs slightly across as well as down, which is what keeps a tall
       sidebar from looking like a single flat slab. -->
  <LinearGradientBrush x:Key="NeuralFacePanel" StartPoint="0,0" EndPoint="0.35,1">
    <GradientStop Color="#181c26" Offset="0"/>
    <GradientStop Color="#12151e" Offset="0.6"/>
    <GradientStop Color="#0d1016" Offset="1"/>
  </LinearGradientBrush>

  <!-- The one warm metal. Four stops because polished metal has a bright
       lip, a broad body and a fast fall-off — three stops makes plastic. -->
  <LinearGradientBrush x:Key="NeuralFaceGold" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#f7ebcd" Offset="0"/>
    <GradientStop Color="#e4c98f" Offset="0.22"/>
    <GradientStop Color="#c9a55e" Offset="0.62"/>
    <GradientStop Color="#a8863f" Offset="1"/>
  </LinearGradientBrush>

  <!-- Bevels. Top edge lit, bottom edge in shadow, and the fade between
       them placed high so the light reads as coming from above the window
       rather than from the middle of it. -->
  <LinearGradientBrush x:Key="NeuralEdge" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#26FFFFFF" Offset="0"/>
    <GradientStop Color="#0CFFFFFF" Offset="0.35"/>
    <GradientStop Color="#59000000" Offset="1"/>
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="NeuralEdgeSoft" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#18FFFFFF" Offset="0"/>
    <GradientStop Color="#08FFFFFF" Offset="0.4"/>
    <GradientStop Color="#3D000000" Offset="1"/>
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="NeuralEdgeGold" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#B3FFF4D9" Offset="0"/>
    <GradientStop Color="#59C9A55E" Offset="0.45"/>
    <GradientStop Color="#A6583F14" Offset="1"/>
  </LinearGradientBrush>

  <!-- Ink for text sitting ON the gold. White on champagne is unreadable at
       13px; a very dark warm brown keeps the contrast and the metal. -->
  <SolidColorBrush x:Key="NeuralOnGold" Color="#2a2008"/>

</ResourceDictionary>
