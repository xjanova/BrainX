<Solution>
  <!-- Core is listed even though every other project already references it.
       Left out, a solution-level `-c Release` gave it no configuration of its
       own, so it built Debug and every Release app copied the unoptimised
       BrainX.Core.dll out of bin\Debug\net9.0 — MSBuild names that path in its
       own copy errors. -->
  <Project Path="BrainX.Core/BrainX.Core.csproj" />
  <Project Path="BrainX.Client/BrainX.Client.csproj" />
  <Project Path="BrainX.Server/BrainX.Server.csproj" />
  <!-- BrainX Server Manager (exe BrainX.ServerManager). Listed so CI compiles it
       on every PR; the release job publishes it into the node zip at manager\. -->
  <Project Path="BrainX.NodeMonitor/BrainX.NodeMonitor.csproj" />
  <Project Path="BrainX.Mcp/BrainX.Mcp.csproj" />
  <Project Path="BrainX.Mind/BrainX.Mind.csproj" />
  <Project Path="BrainX.Tests/BrainX.Tests.csproj" />
  <!-- Signs the node release packages (build-and-release.yml). Listed so PR CI
       compiles it; a signer that only builds at release time breaks releases. -->
  <Project Path="tools/NodeReleaseSigner/NodeReleaseSigner.csproj" />
</Solution>
