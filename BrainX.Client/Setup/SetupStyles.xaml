<!--
  The setup wizard's controls, in the design boards' colours (bg #070B1F,
  text #EAF2FF, muted #A9B8D9, primary #0EA5E9 → #6D28D9). Layout is built in
  code (SetupWizardWindow); this dictionary only holds what XAML does better:
  control templates and their hover/pressed/disabled states.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="SxText" Color="#EAF2FF"/>
    <SolidColorBrush x:Key="SxMuted" Color="#A9B8D9"/>
    <SolidColorBrush x:Key="SxFaint" Color="#8A9AC0"/>
    <SolidColorBrush x:Key="SxSky" Color="#38BDF8"/>
    <SolidColorBrush x:Key="SxSkyLight" Color="#7DD3FC"/>
    <LinearGradientBrush x:Key="SxPrimary" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0EA5E9" Offset="0"/>
        <GradientStop Color="#6D28D9" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SxPrimaryHover" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#22B6F5" Offset="0"/>
        <GradientStop Color="#7C3AED" Offset="1"/>
    </LinearGradientBrush>

    <!-- A button that is only its content: option cards, chips, the girl. -->
    <Style x:Key="SxBare" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="Transparent">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SxPrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Height" Value="52"/>
        <Setter Property="Padding" Value="30,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="root" RenderTransformOrigin="0.5,0.5">
                        <Border x:Name="bg" CornerRadius="14" Background="{StaticResource SxPrimary}">
                            <Border.Effect>
                                <DropShadowEffect x:Name="glow" Color="#38BDF8" BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.35"/>
                            </Border.Effect>
                        </Border>
                        <!-- inset highlight along the top edge -->
                        <Border CornerRadius="14" BorderThickness="0,1,0,0" BorderBrush="#40FFFFFF"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{StaticResource SxPrimaryHover}"/>
                            <Setter TargetName="root" Property="RenderTransform">
                                <Setter.Value><TranslateTransform Y="-1"/></Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="root" Property="RenderTransform">
                                <Setter.Value><TranslateTransform Y="1"/></Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bg" Property="BorderBrush" Value="#BAE6FD"/>
                            <Setter TargetName="bg" Property="BorderThickness" Value="1.5"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="root" Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SxGhostButton" TargetType="Button">
        <Setter Property="Foreground" Value="#DCE8FF"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Height" Value="52"/>
        <Setter Property="Padding" Value="22,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" CornerRadius="14" Background="#0AFFFFFF" BorderBrush="#29FFFFFF" BorderThickness="1">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="#1AFFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bg" Property="BorderBrush" Value="#7DD3FC"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bg" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Google: white glass. -->
    <Style x:Key="SxSsoButton" TargetType="Button" BasedOn="{StaticResource SxGhostButton}">
        <Setter Property="Height" Value="44"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="#EAF2FF"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" CornerRadius="11" Background="#0FFFFFFF" BorderBrush="#29FFFFFF" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="#21FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bg" Property="BorderBrush" Value="#7DD3FC"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bg" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- LINE: its own green. -->
    <Style x:Key="SxLineButton" TargetType="Button" BasedOn="{StaticResource SxSsoButton}">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" CornerRadius="11" Background="#06C755">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="#05B34C"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bg" Property="BorderBrush" Value="#BBF7D0"/>
                            <Setter TargetName="bg" Property="BorderThickness" Value="1.5"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bg" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small ghost (vault "เปลี่ยน", dialog buttons). -->
    <Style x:Key="SxSmallButton" TargetType="Button" BasedOn="{StaticResource SxGhostButton}">
        <Setter Property="Height" Value="30"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" CornerRadius="8" Background="#0AFFFFFF" BorderBrush="#29FFFFFF" BorderThickness="1">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="#1AFFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bg" Property="BorderBrush" Value="#7DD3FC"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bg" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A text link. -->
    <Style x:Key="SxLinkButton" TargetType="Button">
        <Setter Property="Foreground" Value="#7DD3FC"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="0,2">
                        <ContentPresenter x:Name="cp"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="#BAE6FD"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="Foreground" Value="#E0F2FE"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Title bar: minimise and close. -->
    <Style x:Key="SxWinButton" TargetType="Button">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Foreground" Value="#DCE8FF"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="#14FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SxCloseButton" TargetType="Button" BasedOn="{StaticResource SxWinButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="Transparent" CornerRadius="0,15,0,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="#C42B1C"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SxInput" TargetType="TextBox">
        <Setter Property="Height" Value="42"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="#EAF2FF"/>
        <Setter Property="CaretBrush" Value="#7DD3FC"/>
        <Setter Property="SelectionBrush" Value="#38BDF8"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bd" CornerRadius="11" Background="#99030612" BorderBrush="#29FFFFFF" BorderThickness="1">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="#38BDF8"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SxPassword" TargetType="PasswordBox">
        <Setter Property="Height" Value="42"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="#EAF2FF"/>
        <Setter Property="CaretBrush" Value="#7DD3FC"/>
        <Setter Property="SelectionBrush" Value="#38BDF8"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="bd" CornerRadius="11" Background="#99030612" BorderBrush="#29FFFFFF" BorderThickness="1">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="#38BDF8"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SxCheck" TargetType="CheckBox">
        <Setter Property="Foreground" Value="#EAF2FF"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="box" Width="18" Height="18" CornerRadius="5" BorderThickness="1.5"
                                BorderBrush="#5FFFFFFF" Background="Transparent" VerticalAlignment="Center">
                            <Path x:Name="tick" Data="M3.5,9 L7.2,12.6 L14.5,5" Stroke="White" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Visibility="Collapsed" Margin="-1.5"/>
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="box" Property="Background" Value="#38BDF8"/>
                            <Setter TargetName="box" Property="BorderBrush" Value="#38BDF8"/>
                            <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="#BAE6FD"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The CluadeX "install too" switch. -->
    <Style x:Key="SxSwitch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="#EAF2FF"/>
        <Setter Property="FontSize" Value="14.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ContentPresenter VerticalAlignment="Center"/>
                        <Border x:Name="track" Grid.Column="1" Width="46" Height="26" CornerRadius="13"
                                Background="#26FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" Margin="12,0,0,0">
                            <Ellipse x:Name="knob" Width="20" Height="20" Fill="White" HorizontalAlignment="Left" Margin="2,0,0,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.4"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="{StaticResource SxPrimary}"/>
                            <Setter TargetName="track" Property="BorderBrush" Value="#7DD3FC"/>
                            <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="knob" Property="Margin" Value="0,0,2,0"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="track" Property="BorderBrush" Value="#BAE6FD"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SxToolTip" TargetType="ToolTip">
        <Setter Property="Background" Value="#F00B1330"/>
        <Setter Property="Foreground" Value="#EAF2FF"/>
        <Setter Property="BorderBrush" Value="#407DD3FC"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="MaxWidth" Value="380"/>
    </Style>
</ResourceDictionary>
