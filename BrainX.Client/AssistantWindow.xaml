<Window x:Class="BrainX.Client.AssistantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Assistant"
        Width="380" Height="640"
        MinWidth="300" MinHeight="420"
        WindowStyle="None"
        Background="#070A1E"
        ShowInTaskbar="True"
        WindowStartupLocation="Manual">
    <!-- Frameless on purpose: the page draws its own title strip and that
         strip is the drag handle (-webkit-app-region: drag). A chrome
         titlebar above a WebView that already has one is two titlebars. -->
    <Border BorderBrush="#3335E08A" BorderThickness="1">
        <wv2:WebView2 x:Name="AssistantWeb" />
    </Border>
</Window>
