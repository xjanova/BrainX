<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Web SDK, not the plain one: the harness mounts the REAL /mcp endpoint on a
       real Kestrel rather than re-implementing the route, so it needs the same
       ASP.NET Core framework reference BrainX.Server has. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RazorLangVersion>Latest</RazorLangVersion>
    <RootNamespace>BrainX.Tests</RootNamespace>
    <!-- Never published or shipped — this is a developer-run verification tool. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BrainX.Server\BrainX.Server.csproj" />
  </ItemGroup>

  <!-- The release signer's logic, linked (not copied), so the harness signs with
       throwaway keys through the exact code CI runs. -->
  <ItemGroup>
    <Compile Include="..\tools\NodeReleaseSigner\PackageSigner.cs" Link="Linked\PackageSigner.cs" />
  </ItemGroup>

  <!-- A real SignalR client, so the BrainHub authorization checks drive the hub
       exactly as a peer does (same version BrainX.Client ships). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.5" />
  </ItemGroup>

</Project>
